#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# LMChat commit-msg hook.
# Activated via `make install-hooks` (sets `core.hooksPath
# tools/git-hooks`). $1 is the path to the commit-message file per the
# git commit-msg hook contract.
#
# Self-locating: the script is the sibling of this hook's parent dir
# (tools/check_commit_hygiene.py). Resolving by $0 instead of by
# `git rev-parse --show-toplevel` keeps the hook portable across the
# real repo, worktrees, and test fixtures that point `core.hooksPath`
# at this directory.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$HOOK_DIR/../check_commit_hygiene.py"
exec python3 "$SCRIPT" "$1"
