[Unit]
Description=lm-chat v1 — LM Studio web frontend
Documentation=https://github.com/your-org/lm-chat-v1
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=lmchat
Group=lmchat

WorkingDirectory=/opt/lmchat
EnvironmentFile=/etc/lmchat/lmchat.env

ExecStart=/opt/lmchat/.venv/bin/uvicorn \
    lmchat.app:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data /var/log/lmchat

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lmchat

[Install]
WantedBy=multi-user.target
