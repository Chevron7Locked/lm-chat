# lmchat environment — copy to /etc/lmchat/lmchat.env and fill in values.
# Permissions: 640, owned by root:lmchat (readable by the service user only).
#   sudo install -m 640 -o root -g lmchat lmchat.env /etc/lmchat/lmchat.env
#
# Variable names bind directly to src/lmchat/config.py Settings fields
# (pydantic-settings, case_sensitive=False, no env_prefix).

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////data/lmchat.db

# ── LM Studio ────────────────────────────────────────────────────────────────
# Base URL of the LM Studio server on this machine or the local network.
LM_STUDIO_BASE_URL=http://localhost:1234

# Optional: API key if LM Studio authentication is enabled.
# LM_STUDIO_API_KEY=

# ── Session security ─────────────────────────────────────────────────────────
# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The TOTP key is derived from this secret via SHAKE-256 — no separate key needed.
LM_CHAT_SECRET=REPLACE_ME

# Optional: enforce single active session per user (default: true).
# LM_CHAT_SINGLE_SESSION=true

# Optional: issuer label displayed in TOTP authenticator apps (default: lm-chat).
# LM_CHAT_TOTP_ISSUER=lm-chat

# ── Server ───────────────────────────────────────────────────────────────────
# HOST and PORT are set via uvicorn CLI flags in the service unit;
# override here only if you know what you're doing.
# LM_CHAT_HOST=0.0.0.0
# LM_CHAT_PORT=8000

# ── Trusted proxy ────────────────────────────────────────────────────────────
# Set to true when behind a trusted reverse proxy that sets X-Forwarded-Proto.
# LM_CHAT_TRUST_FORWARDED_PROTO=true

# ── Logging ──────────────────────────────────────────────────────────────────
# LM_CHAT_LOG_LEVEL=INFO

# ── Memory ────────────────────────────────────────────────────────────────────
# Optional: per-user cap on pinned memory insights (default: 100).
# LM_CHAT_PINNED_INSIGHTS_CAP=100

# ── Streaming ────────────────────────────────────────────────────────────────
# Optional: idle timeout for an open SSE stream before server closes it (default: 300 s).
# A short cap aborts legitimately-slow local-model prompt-processing — keep it generous.
# LM_CHAT_STREAM_IDLE_TIMEOUT_SEC=300

# Optional: how long the reaper waits for a stream to finalise (default: 5 s).
# LM_CHAT_REAPER_FINALIZATION_TIMEOUT_SEC=5

# Optional: maximum age of a draft stream before the reaper discards it (default: 24 h).
# LM_CHAT_REAPER_DRAFT_MAX_AGE_HOURS=24

# ── MCP integrations ─────────────────────────────────────────────────────────
# Pre-arm discovered MCP tools in every new chat. Default false (tools are
# opt-in per chat); set true to restore the pre-1.0 auto-enabled behavior.
# LM_CHAT_DEFAULT_INTEGRATIONS_ENABLED_BY_DEFAULT=false

# ── Quality modes ─────────────────────────────────────────────────────────────
# Optional: self-consistency convergence threshold (default: 0.85; range: 0.0–1.0).
# LM_CHAT_SC_THRESHOLD=0.85

# ── A/B compare ───────────────────────────────────────────────────────────────
# Optional: per-pane output-token cap for A/B compare mode (default: 32768).
# LM_CHAT_AB_MAX_OUTPUT_TOKENS=32768
