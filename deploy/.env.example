# lm-chat deploy/.env.example
#
# Copy this to deploy/.env (which is gitignored) and fill in real values.
# Never commit deploy/.env — it contains credentials.
#
# Required minimum: LM_CHAT_SECRET (generate one) + LM_STUDIO_BASE_URL
# (point at your LM Studio install).  Defaults for the rest are sane.

# ─── Required ───────────────────────────────────────────────────────────────

# Session-signing secret.  REQUIRED — the app raises a startup error and
# refuses to boot if this is empty (see src/lmchat/config.py,
# _validate_secret_present).  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (or: openssl rand -hex 32).  Set this before your first `docker compose up`.
LM_CHAT_SECRET=

# Where lm-chat reaches LM Studio.
#   - On Docker (Mac/Windows host): http://host.docker.internal:1234
#   - On Docker (Linux host with --add-host): same
#   - On bare-metal / same machine as LM Studio: http://localhost:1234
#   - On a remote LM Studio: http://<host-or-tailnet-ip>:1234
LM_STUDIO_BASE_URL=http://host.docker.internal:1234

# ─── Optional: LM Studio auth ───────────────────────────────────────────────

# Only set if your LM Studio install requires an API key (most don't by
# default; LM Studio's per-key auth is opt-in).  Leave empty otherwise.
LM_STUDIO_API_KEY=

# Default model lm-chat uses if a chat has no per-chat model override.
# Leave empty to fall back to the first loaded model LM Studio reports
# (recommended for most installs).  Override only if you want a specific
# model pinned as the global default.
LM_STUDIO_DEFAULT_MODEL=

# ─── Host / container networking ────────────────────────────────────────────

# Bind address inside the container.  0.0.0.0 is required for the
# host-port mapping in docker-compose.yml to work.  Do NOT use 0.0.0.0 on
# bare-metal without a reverse proxy in front.
LM_CHAT_HOST=0.0.0.0

# In-container port lm-chat listens on.  The compose file maps this to
# LM_CHAT_HOST_PORT on the host.  Leave at 8000 unless you have a conflict.
LM_CHAT_PORT=8000

# Host-side port for the Docker mapping (host:LM_CHAT_HOST_PORT → container:8000).
# Matches the documented default (8000). Change only if 8000 is already
# taken on your host.
LM_CHAT_HOST_PORT=8000

# ─── Logging ────────────────────────────────────────────────────────────────

# DEBUG / INFO / WARNING / ERROR
LM_CHAT_LOG_LEVEL=INFO

# ─── Web search (optional, used by /search slash command) ───────────────────

# Provider: ddg (DuckDuckGo, keyless — chosen as this example's active value
# below) or searxng (the code default; requires LM_CHAT_SEARXNG_URL).
LM_CHAT_WEB_SEARCH_PROVIDER=ddg

# SearXNG instance URL (only needed if provider=searxng).
# LM_CHAT_SEARXNG_URL=https://searx.be

# ─── Advanced / less-common ─────────────────────────────────────────────────

# See src/lmchat/config.py for the full set.  Common extras:
# LM_CHAT_PINNED_INSIGHTS_CAP=100
# LM_CHAT_STREAM_IDLE_TIMEOUT_SEC=1800
# LM_CHAT_DOCUMENT_MAX_BYTES=52428800
# LM_CHAT_AVAILABLE_INTEGRATIONS=mcp/searxng,mcp/crawl4ai
# Pre-arm discovered MCP tools in every new chat. Default false (tools are
# opt-in per chat); set true to restore the pre-1.0 auto-enabled behavior.
# LM_CHAT_DEFAULT_INTEGRATIONS_ENABLED_BY_DEFAULT=false
# Native-mode picker reads LM Studio's MCP config from ~/.lmstudio/mcp.json by
# default (in a container: /home/nonroot/.lmstudio/mcp.json — the compose mount
# target). Override the location here, e.g. if you mount it elsewhere or sync a
# copy on a split-host box. Only used when local MCP discovery is enabled.
# LM_CHAT_LMSTUDIO_MCP_CONFIG_PATH=/home/nonroot/.lmstudio/mcp.json
