# Copy to .env.local and fill in. .env.local is gitignored.
# The harness (docs/LM_STUDIO_HARNESS.md) sources this file.
#
# Variable names bind directly to src/lmchat/config.py Settings fields
# (pydantic-settings, case_sensitive=False, no env_prefix).
# Every field is listed here; optional fields are commented out with their defaults.

# ── Security ──────────────────────────────────────────────────────────────────

# Required: session cookie + token signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The TOTP encryption key is derived from this via SHAKE-256 — no separate key needed.
# Never commit a real value. Store production keys in a secret manager.
LM_CHAT_SECRET=REPLACE-WITH-GENERATED-SECRET

# Optional: trust X-Forwarded-Proto header from a reverse proxy (default: false).
# Enable when running behind nginx/Caddy/etc. that terminates TLS.
#LM_CHAT_TRUST_FORWARDED_PROTO=true

# Optional: IP or CIDR of the trusted reverse proxy (default: empty — any IP trusted
# when TRUST_FORWARDED_PROTO is true). Set to a specific IP for stricter validation.
#LM_CHAT_TRUSTED_PROXY=127.0.0.1

# Optional: comma-separated allowed CORS origins (default: empty — no CORS exposure).
# Example: CORS_ALLOW_ORIGINS=https://app.example.com,https://staging.example.com
#CORS_ALLOW_ORIGINS=

# Optional: session cookie TTL in seconds (default: 2592000 = 30 d).
#LM_CHAT_SESSION_TTL_SECONDS=2592000

# Optional: enforce single active session per user (default: true).
# When true, logging in from a new browser invalidates all previous sessions.
#LM_CHAT_SINGLE_SESSION=true

# Optional: issuer label displayed in TOTP authenticator apps (default: lm-chat).
#LM_CHAT_TOTP_ISSUER=lm-chat

# Optional: inject the follow-up-suggestions directive into the system prompt
# server-side so the model emits <!--followups:[...]--> after answers
# (default: true). Disable to remove the chip suggestion UI in the chat.
#LM_CHAT_FOLLOWUPS_ENABLED=true

# Optional: C3 — after a completed main-chat assistant turn, ask a separate
# out-of-band call which role preset (if any) the NEXT turn should run under,
# and apply it automatically (default: false — an adopted mode changes the
# user's next-message persona + temperature, so it stays opt-in).
#LM_CHAT_MODE_ADOPTION_ENABLED=false

# ── Database ──────────────────────────────────────────────────────────────────

# SQLAlchemy async database URL (default: local SQLite file).
# For Postgres: postgresql+asyncpg://user:pass@host/dbname
#DATABASE_URL=sqlite+aiosqlite:///./lmchat.db

# ── LM Studio ─────────────────────────────────────────────────────────────────

# Base URL of the LM Studio API server (default: localhost).
LM_STUDIO_BASE_URL=http://localhost:1234

# API key if LM Studio authentication is enabled (default: empty).
LM_STUDIO_API_KEY=sk-lm-REPLACE-ME

# Default model identifier shown in the chat UI (default: none — the UI uses
# whatever model is loaded/selected). Set to pin a specific model id.
#LM_STUDIO_DEFAULT_MODEL=

# Timeout in seconds for long-running LM Studio operations like model load/download
# (default: 600 s = 10 min; large models on slow drives may need more).
#LM_CHAT_LMSTUDIO_LONG_OP_TIMEOUT_SECONDS=600.0

# ── Rate limits ───────────────────────────────────────────────────────────────

# Max login attempts per minute per (IP, username) pair (default: 10).
#LM_CHAT_LOGIN_RATE_LIMIT_PER_MIN=10

# Max login attempts per minute per IP, across ALL usernames (default: 30).
# Closes the username-rotation evasion of the per-account cap above.
#LM_CHAT_LOGIN_RATE_LIMIT_PER_IP_PER_MIN=30

# Max chat streams per minute per authenticated user (default: 30).
#LM_CHAT_STREAM_RATE_LIMIT_PER_MIN=30

# Max admin API requests per minute per admin user (default: 30).
#LM_CHAT_ADMIN_RATE_LIMIT_PER_MIN=30

# ── Document limits ───────────────────────────────────────────────────────────

# Maximum upload size for RAG documents in bytes (default: 52428800 = 50 MB).
#LM_CHAT_DOCUMENT_MAX_BYTES=52428800

# Reciprocal Rank Fusion constant k for RAG retrieval blending (default: 60).
#LM_CHAT_RRF_K=60

# Optional: RAG rerank stage over the fused candidates. "mmr" (default) applies
# a dependency-free Maximal Marginal Relevance diversity re-rank — a no-op when
# the top hits are already diverse, and it rescues duplicate-heavy docs (plain
# RRF would return the same chunk twice). "off" restores exact plain-RRF order.
# mmr_lambda in [0,1] trades relevance (1.0) vs diversity (0.0); default 0.5.
#LM_CHAT_RAG_RERANK_MODE=mmr
#LM_CHAT_RAG_RERANK_MMR_LAMBDA=0.5

# Optional: per-user cap on pinned memory insights (default: 100).
# Lower values bound memory storage growth; v0.5.x used 5 (single-user).
#LM_CHAT_PINNED_INSIGHTS_CAP=100

# Optional: enable auto-memory distillation — an out-of-band LLM pass that
# extracts 0-3 durable facts after each completed turn (default: true).
#LM_CHAT_MEMORY_DISTILLATION_ENABLED=true

# Optional: also distill memories from sub-sessions (research / sub-agent /
# tool-mode turns), not just main chats. Off by default; requires the master
# distillation flag above to also be enabled (default: false).
#LM_CHAT_SUBSESSION_MEMORY_DISTILLATION_ENABLED=false

# Optional: per-user cap on AUTO (distilled, pinned=False) memory insights;
# oldest least-recently-used rows fade past the cap (default: 200).
#LM_CHAT_AUTO_MEMORY_CAP=200

# ── Streaming ─────────────────────────────────────────────────────────────────

# Optional: idle timeout for an open SSE stream before the server closes it (default: 300 s).
#LM_CHAT_STREAM_IDLE_TIMEOUT_SEC=300

# Optional: budget for fire-and-forget background aux model calls — auto-title,
# compaction summary, auto-memory distillation, follow-up chips. Local models are
# naturally slow and nothing waits on these, so keep it generous (default: 900 s).
#LM_CHAT_AUX_MODEL_TIMEOUT_SEC=900.0

# Optional: budget for an MCP tool call before it's cut (default: 300 s — aligned
# with the idle timeout, since tool calls run on the turn path).
#LM_CHAT_MCP_TOOL_CALL_TIMEOUT_SEC=300.0

# Optional: tool-call repeat-loop cut threshold (K) — abort a turn once the
# streaming client has flagged the same tool call K times (default: 16;
# range 0-100; 0 disables). Config-level default only — also adjustable at
# runtime via the admin app-settings override and a per-chat override.
#LM_CHAT_REPEAT_WARNING_CUT_K=16

# Optional: max characters of a sub-session's output injected back into the main
# chat before it is truncated with a marker (default: 8000; 0 or negative disables
# the cap).
#LM_CHAT_SUB_SESSION_OUTPUT_MAX_CHARS=8000

# Optional: how long the reaper waits for a stream to finalise before force-closing (default: 5 s).
#LM_CHAT_REAPER_FINALIZATION_TIMEOUT_SEC=5

# Optional: maximum age of a draft (incomplete) stream before the reaper discards it (default: 24 h).
#LM_CHAT_REAPER_DRAFT_MAX_AGE_HOURS=24

# Optional: period in seconds between background re-probes of the LM Studio model catalog
# (default: 1800 = 30 min). The lifespan task refreshes once at startup, then sleeps this
# long between probes. Manual POST /api/admin/models/refresh is always available. Min 60 s.
#LM_CHAT_MODELS_CACHE_REFRESH_INTERVAL_SECONDS=1800

# Optional: TTL in seconds for the loaded-models set, checked on-demand inside
# the streaming model-resolution path (default: 5). When the cache is older than
# this, a fresh re-probe runs so a model unloaded directly in LM Studio is noticed
# in seconds instead of waiting out the 30-min catalog refresh. Min 1 s.
#LM_CHAT_LOADED_MODELS_TTL_SECONDS=5

# ── Quality modes ─────────────────────────────────────────────────────────────

# Optional: self-consistency convergence threshold — maximum pairwise cosine similarity
# across SC drafts at which convergence is declared (default: 0.85; range: 0.0–1.0).
# Lower values converge sooner; higher values require tighter agreement between drafts.
#LM_CHAT_SC_THRESHOLD=0.85

# Optional: watchdog timeout (s) after which a hung quality-mode turn is cancelled and
# falls back to a normal answer (default: 7200 = 2 h; far beyond any real run, only catches a true hang).
#LM_CHAT_QUALITY_MODE_TIMEOUT_SEC=7200

# ── A/B compare ───────────────────────────────────────────────────────────────

# Optional: per-pane output-token cap for A/B compare mode (default: 32768).
# A/B compare runs two simultaneous completions; the cap prevents GPU memory saturation.
#LM_CHAT_AB_MAX_OUTPUT_TOKENS=32768

# ── Web search ────────────────────────────────────────────────────────────────

# Web search provider: "searxng" (default), "ddg" (keyless, via the ddgs
# library), "brave" (keyed Brave Search API), or "brave_llm" (keyed Brave
# Search — LLM Context: pre-extracted page chunks instead of links +
# one-line snippets). "brave"/"brave_llm" require LM_CHAT_BRAVE_API_KEY below.
#LM_CHAT_WEB_SEARCH_PROVIDER=searxng

# SearXNG instance URL (default: public searx.be; self-host for reliability).
#LM_CHAT_SEARXNG_URL=https://searx.be

# P12c: Allow SearXNG URL targeting private/loopback IPs (e.g. docker on localhost).
# Default: false. Set to true ONLY for self-hosted instances on the same host.
#LM_CHAT_ALLOW_PRIVATE_SEARXNG=false

# Brave Search API key — required for LM_CHAT_WEB_SEARCH_PROVIDER=brave OR
# =brave_llm (same key, two endpoints/response shapes). A real keyed search
# API, no scraping. Free tier is ~2k queries/month; get a key at
# https://brave.com/search/api/.
#LM_CHAT_BRAVE_API_KEY=

# ── Reverse proxy / server ────────────────────────────────────────────────────

# Bind address for the uvicorn server (default: 127.0.0.1).
# Use 0.0.0.0 when running inside Docker or behind a reverse proxy.
#LM_CHAT_HOST=127.0.0.1

# Bind port for the uvicorn server (default: 8000).
#LM_CHAT_PORT=8000

# ── MCP Integrations ──────────────────────────────────────────────────────────

# P12e: Operator-supplied list of MCP integration IDs (e.g. "mcp/searxng,mcp/filesystem").
# LM Studio does not expose MCP server enumeration over HTTP; see docs/INTEGRATION_MAP.md §3
# and docs/release/INCIDENT_REPORT_2026_05_21.md for the full rationale.
# This is the env-var fallback; the admin DB list (maintained at /admin/integrations) takes
# precedence when any rows are present. Comma-separated; omit leading/trailing whitespace.
# Sync workflow: when adding or removing MCP servers in LM Studio's desktop UI, update
# this list to match (no auto-discovery). See docs/deployment.md "MCP integrations list".
#LM_CHAT_AVAILABLE_INTEGRATIONS=

# ── Observability ─────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, or ERROR (default: INFO).
#LM_CHAT_LOG_LEVEL=INFO

# OpenAPI spec server URL (default: "/" = same-origin).
# Override when hosting the API under a non-root path or external hostname.
#LM_CHAT_OPENAPI_SERVER_URL=/

# ── Incognito chats (P13i) ────────────────────────────────────────────────────

# Default lifetime of an incognito chat in seconds (default: 3600 = 1 hour).
# Incognito chats persist for this long after creation, then the periodic
# purge sweeps them. Logout sweeps all of a user's incognito chats
# immediately regardless of TTL.
#LM_CHAT_INCOGNITO_TTL_SECONDS=3600

# Period in seconds between background TTL-purge sweeps (default: 300 = 5 min).
# Smaller = tighter cleanup latency; larger = less DB churn.
#LM_CHAT_INCOGNITO_PURGE_INTERVAL_SECONDS=300

# ── MCP integrations discovery ────────────────────────────────────────────────

# When True (default) the IntegrationsService falls back to reading
# `~/.lmstudio/mcp.json` if the DB list is empty — same-host deployments get
# zero-config MCP discovery. Set False for split-host deployments (LM Chat and
# LM Studio on different boxes — the file is meaningless) or in hermetic
# test environments where the dev machine's mcp.json would leak into fixtures.
#LM_CHAT_LOCAL_MCP_DISCOVERY_ENABLED=true

# Override the path the native-mode picker's file-discovery tier reads LM
# Studio's MCP config from. Empty (default) = ~/.lmstudio/mcp.json (in a
# container: /home/nonroot/.lmstudio/mcp.json — mount the file there, or set
# this). Useful for a non-standard mount target or a split-host deploy.
# Only consulted when LM_CHAT_LOCAL_MCP_DISCOVERY_ENABLED is true.
#LM_CHAT_LMSTUDIO_MCP_CONFIG_PATH=

# When True (default) integrations discovered from `~/.lmstudio/mcp.json`
# (tier 2) and from the env list (tier 3) are surfaced to the chat composer
# with `enabled_by_default=True`. Operator's standing preference is that
# locally-registered MCP servers are available by default. Set False if you
# want the synthetic-fallback path to remain opt-in per-message.
#LM_CHAT_DEFAULT_INTEGRATIONS_ENABLED_BY_DEFAULT=true

# ── First-run setup (P13f) ────────────────────────────────────────────────────

# Optional one-shot token gating POST /api/auth/register on an empty DB.
# When set, the first registration must pass the token via ?token= query param
# or X-Setup-Token header. The gate auto-lifts once the first user exists.
# Leave unset for normal "first registered user becomes admin" behaviour.
#LM_CHAT_SETUP_TOKEN=
