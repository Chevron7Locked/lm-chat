/mobile-*.md
/*-snapshot.md
# NOTE: /screenshots/ intentionally NOT ignored — it holds tracked demo
# screenshots (dark+light, desktop+mobile) used in pitch material.

# AI-generated workflow scratch. Panel briefs, seat transcripts, verdicts,
# and review findings files are session-local artifacts. The repo
# tracks operator-curated docs only (PLAN.md, ADRs, INTEGRATION_MAP.md,
# README, CHANGELOG, ARCHITECTURE.md, the harness probes, etc.). Anything
# matching the patterns below is scratch and never committed.
docs/reports/
docs/FEATURE_CATALOGUE.md

# Tool / agent local state (operator-private)
.claude/
.serena/
.schemathesis/
deploy/.env
*.png
!screenshots/**/*.png
.playwright-mcp/
# Any lmchat.db snapshot/backup (.preflip, .preflip-shm/-wal, .fresh-*, .bak-*, …).
# These are real SQLite DBs (auth hashes, encrypted secrets, chat history) — the
# base *.db pattern above does NOT match the dotted-suffix variants. Never track.
lmchat.db.*
screenshots/v1/originals-v0.5/

# AI-process planning/design docs — kept locally, not committed
docs/audit/

# generated coverage artifacts
coverage/

# Internal engineering docs — kept LOCAL, not published to GitHub.
# docs/ was untracked (git rm -r --cached) 2026-06-21; this blanket supersedes
# the per-path docs/ rules above. NOTE: the git HISTORY still contains docs/,
# so it MUST be purged from history before the first push — see
# PURGE_BEFORE_PUSH.md (also gitignored / local-only).
docs/
PURGE_BEFORE_PUSH.md
