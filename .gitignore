# Secrets — never commit. Match every .env variant at ANY depth (bare .env,
# web/.env, .env.production, .env.*.local, …); the two tracked *.example
# placeholders are explicitly re-included below.
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# Generated by `make validate-deploy` (P12g) — placeholder env, never commit
.env.validate

